# FastASL - Phase 1 environment variables (example).
# Copy to .env for local development. Never commit a real .env.
#
# IMPORTANT: This file documents variable NAMES only.
# The validation contract (allowed values, defaults, ranges, failure rules)
# is owned by HUMAN-3 and lives in src/config/env.js.

# development | test | production
NODE_ENV=

# Network interface the server binds to
HOST=

# TCP port the server listens on
PORT=

# Pino log level
LOG_LEVEL=

# Maximum accepted JSON request body size (e.g. "100kb")
REQUEST_BODY_LIMIT=
