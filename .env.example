# FastASL environment example. Copy to .env for local development.
# Never commit a real .env. Values supplied by the environment are validated;
# malformed values fail startup instead of being replaced by these defaults.

# development | test | production (default: development)
NODE_ENV=development

# 1-255 non-whitespace characters (default: 127.0.0.1)
HOST=127.0.0.1

# Canonical decimal integer from 1 through 65535 (default: 3000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Integer lowercase-kb value from 1kb through 100kb (default: 100kb)
REQUEST_BODY_LIMIT=100kb

# Real MySQL test connection. Copy this file to .env.test, set NODE_ENV=test,
# supply the local non-root test password, and opt in only after reading
# docs/MYSQL_TESTING.md. .env.test is ignored and must never be committed.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fastasl_test
MYSQL_USER=fastasl_test
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=2
MYSQL_TEST_ALLOW_DESTRUCTIVE=false
