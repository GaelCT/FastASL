# Deny direct access to PHP files except the main entry point
# This prevents attackers from directly accessing utility/config files
<FilesMatch "\.(php|ini|yaml|yml|log|md)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow the main entry point
<FilesMatch "^(index|validation)\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny access to hidden files
<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>
