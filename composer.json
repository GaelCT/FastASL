{
    "name": "gaelct/fastasl",
    "description": "ASL Racer - A typing race game with American Sign Language integration",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "backend/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --level=1 backend/ src/",
        "phpstan-max": "phpstan analyse --level=9 backend/ src/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
