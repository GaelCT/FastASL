{
  "name": "fastasl",
  "version": "0.1.0",
  "private": true,
  "description": "FastASL - Node.js reboot. Phase 1: clean Node/Express foundation (no auth, no database, no leaderboard).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "check:ownership": "node scripts/check-human-ownership.mjs",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "supertest": "^7.2.2"
  }
}
