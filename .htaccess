# ASL Racer — Repository root .htaccess
# IMPORTANT: The document root must be the public/ directory.
# This file exists only as defense in depth for misconfigured servers
# that point the document root at the repository root.
# All requests to the repository root are denied.

Order Deny,Allow
Deny from all

# Deny access to sensitive files even if overrides bypass the rule above
<FilesMatch "\.(env|sql|md|log|yaml|yml|json|lock|pdf|zip)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>
